{
  "name": "asli-ai-chat",
  "main": "server/chat.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "SITE_ORIGIN": "https://cemileors879-eng.github.io" },
  "ai": { "binding": "AI" },
  "ratelimits": [{
    "name": "CLIENT_RATE",
    "namespace_id": "1001",
    "simple": { "limit": 8, "period": 60 }
  }],
  "durable_objects": {
    "bindings": [{ "name": "DAILY_QUOTA", "class_name": "DailyQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyQuota"] }]
}
